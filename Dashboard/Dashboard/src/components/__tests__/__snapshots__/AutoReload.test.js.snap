exports[`render corectly: load countdown from user settings 1`] = `
<div
  className="btn-refresh right border-white"
  onClick={[Function]}>
  <i
    className="icon-refresh" />
  <span
    className="currentCountdown">
    100s
  </span>
  <i
    className="icon-menu-down" />
</div>
`;

