exports[`custom legend plugin: no dataset: do not render 1`] = `
<div
  callbackParent="fake callbackParent"
  isLoading={false}
  name="WidgetBox"
  title="Turnover by Platform (Month to date)"
  wgItem="fake wgItemFromParent"
  widgetKey="c_turnover"
  widgetName="turnover default">
  <div
    data={
      Object {
        "datasets": Array [
          Object {
            "backgroundColor": Array [
              "#35A1FB",
              "#4B966B",
              "#4C6375",
              "#D9544F",
              "#4473C5",
            ],
            "currency": "USD",
            "data": Array [
              1.2,
              3.4,
            ],
          },
        ],
        "labels": Array [
          "Total Turnover",
          "Non - Deposit",
        ],
      }
    }
    name="Doughnut"
    options={
      Object {
        "animation": Object {
          "onComplete": [Function],
        },
        "hover": Object {
          "animationDuration": 0,
        },
        "layout": Object {
          "padding": Object {
            "bottom": 50,
            "right": 130,
            "top": 10,
          },
        },
        "legend": Object {
          "custom": true,
          "display": false,
          "id": "custom-legend",
        },
        "maintainAspectRatio": false,
        "tooltips": Object {
          "enabled": false,
        },
      }
    }>
    hello bar
  </div>
  <div
    id="custom-legend" />
  <div
    className="footer-total">
    <span>
      Total Turnover
      : 
      $98,765.43
       
    </span>
  </div>
</div>
`;

